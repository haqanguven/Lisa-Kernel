  */
@@ -18,9 +18,10 @@
 #include <linux/interrupt.h>
 #include <linux/mtd/mtd.h>
 #include <linux/kmsg_dump.h>
+#include <linux/backlight.h>
 
 /* Maximum MTD partition size */
-#define MTDOOPS_MAX_MTD_SIZE (8 * 1024 * 1024)
+#define MTDOOPS_MAX_MTD_SIZE (16 * 1024 * 1024)
 
 #define MTDOOPS_KERNMSG_MAGIC 0x5d005d00
 #define MTDOOPS_HEADER_SIZE   8
@@ -288,6 +289,41 @@ static void mtdoops_do_dump(struct kmsg_dumper *dumper,
 	}
 }
 
+/* Opt-in diagnostic snapshots; disabled for normal builds/boots. */
+static unsigned int boot_snapshot;
+module_param(boot_snapshot, uint, 0400);
+MODULE_PARM_DESC(boot_snapshot, "Take two boot log snapshots at this interval in seconds (0 disables)");
+static unsigned int boot_snapshot_count;
+static void mtdoops_boot_snapshot(struct work_struct *work);
+static DECLARE_DELAYED_WORK(boot_snapshot_work, mtdoops_boot_snapshot);
+
+static void mtdoops_boot_snapshot(struct work_struct *work)
+{
+	if (!oops_cxt.mtd)
+		return;
+	pr_notice("mtdoops: diagnostic boot snapshot %u\n", ++boot_snapshot_count);
+#if IS_BUILTIN(CONFIG_BACKLIGHT_CLASS_DEVICE)
+	/* Read-only boot diagnostics; the built-in panel is not unregistered. */
+	{
+		struct backlight_device *bd;
+
+		bd = backlight_device_get_by_type(BACKLIGHT_RAW);
+		if (bd)
+			pr_notice("lisa-panel: name=%s brightness=%d max=%d power=%d fb_blank=%d state=0x%x\n",
+				  dev_name(&bd->dev), bd->props.brightness,
+				  bd->props.max_brightness, bd->props.power,
+				  bd->props.fb_blank, bd->props.state);
+		else
+			pr_notice("lisa-panel: no BACKLIGHT_RAW device\n");
+	}
+#endif
+
+	kmsg_dump(KMSG_DUMP_OOPS);
+	if (boot_snapshot_count < 2)
+		schedule_delayed_work(&boot_snapshot_work,
+				     msecs_to_jiffies(boot_snapshot * 1000));
+}
+
 static void mtdoops_notify_add(struct mtd_info *mtd)
 {
 	struct mtdoops_context *cxt = &oops_cxt;
@@ -340,6 +376,11 @@ static void mtdoops_notify_add(struct mtd_info *mtd)
 	cxt->oops_pages = (int)mtd->size / record_size;
 	find_next_position(cxt);
 	printk(KERN_INFO "mtdoops: Attached to MTD device %d\n", mtd->index);
+	if (boot_snapshot && boot_snapshot <= 300) {
+		dump_oops = 1;
+		schedule_delayed_work(&boot_snapshot_work,
+				     msecs_to_jiffies(boot_snapshot * 1000));
+	}
 }
 
 static void mtdoops_notify_remove(struct mtd_info *mtd)
@@ -352,6 +393,7 @@ static void mtdoops_notify_remove(struct mtd_info *mtd)
 	if (kmsg_dump_unregister(&cxt->dump) < 0)
 		printk(KERN_WARNING "mtdoops: could not unregister kmsg_dumper\n");
 
+	cancel_delayed_work_sync(&boot_snapshot_work);
 	cxt->mtd = NULL;
 	flush_work(&cxt->work_erase);
 	flush_work(&cxt->work_write);
diff --git a/init/Kconfig b/init/Kconfig
index 75be22dc8..a7b5ab89e 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -2398,3 +2398,24 @@ config ARCH_HAS_SYSCALL_WRAPPER
 	def_bool n
 
 source "init/Kconfig.gki"
+
+config ANDROID_NETBPFLOAD_COMPAT
+	bool "Android netbpfload version compatibility for backported BPF"
+	depends on ANDROID && BPF_SYSCALL && BPF_JIT
+	default n
+	help
+	  Report a 5.10 compatibility release only to netbpfload. This permits
+	  Android 17's version gate to reach the real BPF feature checks on
+	  this 5.4 tree with its 5.10 BPF backports. It does not upgrade Linux
+	  or add BPF functionality. Enable only with the matching backports
+	  and verify the ROM's BPF objects and device boot. Other callers
+	  continue to receive the kernel's real release.
+
+config MIUI_PROC_VERSION_COMPAT
+	bool "MIUI legacy proc version format compatibility"
+	depends on CC_IS_CLANG
+	default n
+	help
+	  Keep Clang identification in /proc/version with a GCC-compatible
+	  driver annotation and trailing space for older MIUI Settings parsers.
+	  Does not change kernel release, uname or actual compiler selection.
diff --git a/init/version.c b/init/version.c
index cba341161..16a86c0bf 100644
--- a/init/version.c
+++ b/init/version.c
@@ -47,9 +47,20 @@ const char linux_banner[] =
 	"Linux version " UTS_RELEASE " (" LINUX_COMPILE_BY "@"
 	LINUX_COMPILE_HOST ") (" LINUX_COMPILER ") " UTS_VERSION "\n";
 
+/* Older MIUI Settings accepts only a proc-version compiler field starting
+ * with "gcc" and ending in a space. Clang supplies a GCC-compatible driver;
+ * retain its complete, real compiler identification rather than inventing a
+ * GCC version. Kernel release, uname and the boot banner remain unchanged.
+ */
+#ifdef CONFIG_MIUI_PROC_VERSION_COMPAT
+#define MIUI_PROC_COMPILER "gcc-compatible driver: " LINUX_COMPILER " "
+#else
+#define MIUI_PROC_COMPILER LINUX_COMPILER
+#endif
+
 const char linux_proc_banner[] =
 	"%s version %s"
 	" (" LINUX_COMPILE_BY "@" LINUX_COMPILE_HOST ")"
-	" (" LINUX_COMPILER ") %s\n";
+	" (" MIUI_PROC_COMPILER ") %s\n";
 
 BUILD_SALT;
diff --git a/kernel/sys.c b/kernel/sys.c
index fa3f48a51..63b96c309 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1247,6 +1247,17 @@ SYSCALL_DEFINE1(newuname, struct new_utsname __user *, name)
 	down_read(&uts_sem);
 	memcpy(&tmp, utsname(), sizeof(tmp));
 	up_read(&uts_sem);
+	if (IS_ENABLED(CONFIG_ANDROID_NETBPFLOAD_COMPAT)) {
+		char leader_comm[TASK_COMM_LEN];
+
+		get_task_comm(leader_comm, current->group_leader);
+		if (!strcmp(leader_comm, "netbpfload")) {
+			pr_info_once("lisa: netbpfload compatibility release 5.10.248; actual %s\n",
+				     tmp.release);
+			strscpy(tmp.release, "5.10.248", sizeof(tmp.release));
+		}
+	}
+
 	if (copy_to_user(name, &tmp, sizeof(tmp)))
 		return -EFAULT;
 
