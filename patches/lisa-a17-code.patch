diff --git a/init/Kconfig b/init/Kconfig
index 547d7968d..e97bc08aa 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -2437,3 +2437,15 @@ config ARCH_HAS_SYSCALL_WRAPPER
 	def_bool n
 
 source "init/Kconfig.gki"
+
+config ANDROID_NETBPFLOAD_COMPAT
+	bool "Android netbpfload version compatibility for backported BPF"
+	depends on ANDROID && BPF_SYSCALL && BPF_JIT
+	default n
+	help
+	  Report a 5.10 compatibility release only to netbpfload. This permits
+	  Android 17's version gate to reach the real BPF feature checks on
+	  this 5.4 tree with its 5.10 BPF backports. It does not upgrade Linux
+	  or add BPF functionality. Enable only with the matching backports
+	  and verify the ROM's BPF objects and device boot. Other callers
+	  continue to receive the kernel's real release.
diff --git a/kernel/sys.c b/kernel/sys.c
index 66f5da167..33dd6b651 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1264,6 +1264,17 @@ SYSCALL_DEFINE1(newuname, struct new_utsname __user *, name)
 			 (u8)((LINUX_VERSION_CODE >> 16) & 0xff), (u8)((LINUX_VERSION_CODE >> 8) & 0xff),
 			 (u16)(LINUX_VERSION_CODE & 0xffff));
 
+	if (IS_ENABLED(CONFIG_ANDROID_NETBPFLOAD_COMPAT)) {
+		char leader_comm[TASK_COMM_LEN];
+
+		get_task_comm(leader_comm, current->group_leader);
+		if (!strcmp(leader_comm, "netbpfload")) {
+			pr_info_once("lisa: netbpfload compatibility release 5.10.248; actual %s\n",
+				     tmp.release);
+			strscpy(tmp.release, "5.10.248", sizeof(tmp.release));
+		}
+	}
+
 	if (copy_to_user(name, &tmp, sizeof(tmp)))
 		return -EFAULT;
 
diff --git a/scripts/link-vmlinux.sh b/scripts/link-vmlinux.sh
index 3f33809d8..d9b330091 100755
--- a/scripts/link-vmlinux.sh
+++ b/scripts/link-vmlinux.sh
@@ -186,7 +186,13 @@ gen_btf()
 	vmlinux_link ${1}
 
 	info "BTF" ${2}
-	LLVM_OBJCOPY=${OBJCOPY} ${PAHOLE} -J ${1}
+	# This 5.4 kernel accepts BTF kinds up to DATASEC (15).
+	# pahole 1.24+ otherwise emits newer kinds unsupported by its verifier.
+	local btf_flags="--jobs=1"
+	if [ "${pahole_ver}" -ge "124" ]; then
+		btf_flags="${btf_flags} --skip_encoding_btf_enum64 --skip_encoding_btf_decl_tag --skip_encoding_btf_type_tag"
+	fi
+	LLVM_OBJCOPY=${OBJCOPY} ${PAHOLE} ${btf_flags} -J ${1}
 
 	# Create ${2} which contains just .BTF section but no symbols. Add
 	# SHF_ALLOC because .BTF will be part of the vmlinux image. --strip-all
